@page "/Account/Manage/DeletePersonalData"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@inject UserManager<NorseUser> UserManager
@inject SignInManager<NorseUser> SignInManager
@inject ErasureService Erasure
@inject IdentityRedirectManager RedirectManager
@inject ILogger<DeletePersonalData> Logger

<PageTitle>Delete Personal Data</PageTitle>

<StatusMessage Message="@_message"/>

<h3>Delete Personal Data</h3>

<FluentGrid>
    <FluentGridItem sm="9">
        <FluentMessageBar Intent="MessageBarIntent.Warning">
            Deleting this data will permanently remove your account, and this cannot be recovered.
        </FluentMessageBar>
        <EditForm Model="Input" FormName="delete-user" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator/>
            <FluentValidationSummary class="text-danger" role="alert"/>
            @if (_requirePassword)
            {
                <FluentTextInput type="password" Name="Input.Password" @bind-Value="Input.Password"
                                 AutoComplete="new-password" Required="true" Placeholder="Please enter your password." Label="Password"
                                 Style="width: 100%"/>
                @* <FluentValidationMessage For="() => Input.Password" class="text-danger" /> *@
            }
            <p style="margin-top: 10px; text-align: end;">
                <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary">
                    Delete data and close my
                    account
                </FluentButton>
            </p>
        </EditForm>
    </FluentGridItem>
</FluentGrid>

@code {
    const int ShredAttempts = 3;

    string? _message;
    NorseUser? _user;
    bool _requirePassword;

    [CascadingParameter] HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromForm] InputModel Input { get; set; } = null!;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        Input ??= new InputModel();

        _user = await UserManager.GetUserAsync(HttpContext.User);
        if (_user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        _requirePassword = await UserManager.HasPasswordAsync(_user);
    }

    async Task OnValidSubmitAsync()
    {
        if (_user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        if (_requirePassword && !await UserManager.CheckPasswordAsync(_user, Input.Password))
        {
            _message = "Error: Incorrect password.";
            return;
        }

        // Erasure, not UserManager.DeleteAsync: the key goes first, then the row and its OpenIddict rows
        // (explicit-writes spec §7). Retried here, not by submitting again: past the key's destruction this page can
        // no longer load the account, and the session dies at its next revalidation (PR #76 review).
        var userId = await UserManager.GetUserIdAsync(_user);
        var shred = await Erasure.ShredWithRetriesAsync(_user.Id, ShredAttempts);
        if (!shred.Match(static _ => true, static _ => false))
        {
            _message = "Error: Your account could not be fully deleted. The failure has been logged for an administrator to finish.";
            return;
        }

        await SignInManager.SignOutAsync();

        Logger.LogInformation("User with ID '{UserId}' deleted themselves.", userId);

        RedirectManager.RedirectToCurrentPage();
    }

    sealed class InputModel
    {
        [DataType(DataType.Password)] public string Password { get; set; } = "";
    }

}
